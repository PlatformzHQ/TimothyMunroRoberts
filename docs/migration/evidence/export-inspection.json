  "route_metadata": [
    {
      "route": "/",
      "title": "Timothy Munro Roberts \u2014 Technology Founder \u00b7 Enterprise Architect \u00b7 AI Platform Designer",
      "canonical": "https://timothymunroroberts.com/",
      "description": "Timothy Munro Roberts is a technology founder, enterprise architect, and platform designer with 25+ years building and scaling high-availability commerce and infrastructure platforms. He co-founded SAVVIS Communications (NASDAQ: SVVS; later acquired by CenturyLink for ~$3.4B), founded Intira (the first company to sell cloud computing as a service; lineage acquired by Verizon for ~$1.6B via Terremark), and took Phantom Entertainment, StationDigital, and HashingSpace public. Today he is CEO of Platformz and COO/CTO of FUR4.",
      "og_url": "https://timothymunroroberts.com/",
      "twitter_card": "summary_large_image"
    },
    {
      "route": "/story/platformz/",
      "title": "Platformz \u2014 Chief Executive Officer | Timothy Munro Roberts",
      "canonical": "https://timothymunroroberts.com/story/platformz/",
      "description": "A multi-tenant, enterprise-class commerce platform and agency powering consumer brands (pet, sports, and more). Inventor and principal designer of the underlying architecture, with patent filings prepared.",
      "og_url": "https://timothymunroroberts.com/story/platformz/",
      "twitter_card": "summary_large_image"
    },
    {
      "route": "/story/fur4/",
      "title": "FUR4 \u2014 Chief Operating Officer &amp; Chief Technology Officer | Timothy Munro Roberts",
      "canonical": "https://timothymunroroberts.com/story/fur4/",
      "description": "Premium pet-grooming brand led by the original inventor of the Furminator. I own nearly every operational and technical layer \u2014 from the decoupled commerce stack to global manufacturing, finance, and channels.",
      "og_url": "https://timothymunroroberts.com/story/fur4/",
      "twitter_card": "summary_large_image"
    },
    {
      "route": "/story/ceosavvy/",
      "title": "CEOSavvy, LLC \u2014 Managing Director | Timothy Munro Roberts",
      "canonical": "https://timothymunroroberts.com/story/ceosavvy/",
      "description": "An advisory and consulting practice for startups and early/growth-stage companies \u2014 board roles, strategy, finance, and go-to-market for founders moving from idea to fundable business.",
      "og_url": "https://timothymunroroberts.com/story/ceosavvy/",
      "twitter_card": "summary_large_image"
    },
    {
      "route": "/story/hashingspace/",
      "title": "HashingSpace Corporation \u2014 Founder, Chairman, CEO &amp; CTO | Timothy Munro Roberts",
      "canonical": "https://timothymunroroberts.com/story/hashingspace/",
      "description": "A Bitcoin mining, hosting, and data-center company \u2014 plus wallet, exchange, cloud-hashing, Stratum/P2P pools, and a pool scanner. An early, deep bet on Bitcoin and blockchain infrastructure.",
      "og_url": "https://timothymunroroberts.com/story/hashingspace/",
      "twitter_card": "summary_large_image"
    },
    {
      "route": "/story/stationdigital/",
      "title": "StationDigital Corporation \u2014 Founder, Chairman, CEO &amp; CTO | Timothy Munro Roberts",
      "canonical": "https://timothymunroroberts.com/story/stationdigital/",
      "description": "Designed and pioneered an ad-supported, DMCA-compliant digital playlist radio station and video system \u2014 with a catalog of 22M+ tracks \u2014 taken public via reverse merger.",
      "og_url": "https://timothymunroroberts.com/story/stationdigital/",
      "twitter_card": "summary_large_image"
    },
    {
      "route": "/story/savtira/",
      "title": "Savtira Corporation \u2014 Founder, Chairman &amp; CEO | Timothy Munro Roberts",
      "canonical": "https://timothymunroroberts.com/story/savtira/",
      "description": "Designed and pioneered an enterprise-class cloud commerce eco-system for physical and digital goods \u2014 a cross-merchandised 'superstore' with a download manager, cloud locker, and application streaming, on a virtualized IBM WebSphere Commerce SaaS.",
      "og_url": "https://timothymunroroberts.com/story/savtira/",
      "twitter_card": "summary_large_image"
    },
    {
      "route": "/story/gamestreamer/",
      "title": "GameStreamer, Inc. \u2014 Chief Executive Officer &amp; CTO | Timothy Munro Roberts",
      "canonical": "https://timothymunroroberts.com/story/gamestreamer/",
      "description": "Took a B2B video-game distribution company from idea to fully operational \u2014 building the first automated game-publishing system and a white-label storefront SDK. Sold to Media Speed Tech, LLC.",
      "og_url": "https://timothymunroroberts.com/story/gamestreamer/",
      "twitter_card": "summary_large_image"
    },
    {
      "route": "/story/phantom/",
      "title": "Infinum Labs / Phantom Entertainment \u2014 Founder, CEO &amp; CTO | Timothy Munro Roberts",
      "canonical": "https://timothymunroroberts.com/story/phantom/",
      "description": "A PC-based living-room game platform concept, taken public via reverse merger \u2014 pioneering on-demand game delivery a decade before streaming was viable.",
      "og_url": "https://timothymunroroberts.com/story/phantom/",
      "twitter_card": "summary_large_image"
    },
    {
      "route": "/story/phoenix/",
      "title": "Phoenix Networks \u2014 Director &amp; Investor | Timothy Munro Roberts",
      "canonical": "https://timothymunroroberts.com/story/phoenix/",
      "description": "Invested in and served as a director of Phoenix Networks \u2014 a consumer and business DSL provider that grew into one of the top DSL providers in the world.",
      "og_url": "https://timothymunroroberts.com/story/phoenix/",
      "twitter_card": "summary_large_image"
    },
    {
      "route": "/story/intira/",
      "title": "Intira Corporation \u2014 Founder &amp; Chief Executive Officer | Timothy Munro Roberts",
      "canonical": "https://timothymunroroberts.com/story/intira/",
      "description": "Founded Intira to add data centers onto the SAVVIS network design \u2014 and built the first company ever to sell cloud computing as a service ('Netsourcing'), running customers' infrastructure end to end.",
      "og_url": "https://timothymunroroberts.com/story/intira/",
      "twitter_card": "summary_large_image"
    },
    {
      "route": "/story/savvis/",
      "title": "Diamond.net / SAVVIS Communications \u2014 Co-founder &amp; Chief Technology Officer | Timothy Munro Roberts",
      "canonical": "https://timothymunroroberts.com/story/savvis/",
      "description": "Co-founded Diamond.net (aka SAVVIS) and, as CTO, designed the first high-quality national Internet backbone \u2014 originating the concepts of QoS guarantees, metered billing, and PNAPs with the world's first OC3 ATM Layer-2 backbone linking 22 Tier-1 cities.",
      "og_url": "https://timothymunroroberts.com/story/savvis/",
      "twitter_card": "summary_large_image"
    }
  ],
